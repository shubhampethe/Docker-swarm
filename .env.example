# ==========================================
# RAG Pipeline Configuration
# ==========================================

# 1. LlamaIndex / LlamaParse API Configuration
# Get your free key at https://cloud.llamaindex.ai
LLAMA_CLOUD_API_KEY=llx-your-llamaparse-api-key
LLAMA_PARSE_RESULT_TYPE=markdown
LLAMA_PARSE_LANGUAGE=en

# 2. Custom Embedding Service Container (all-MiniLM-L6-v2)
EMBEDDING_API_URL=http://localhost:8001
EMBEDDING_BATCH_SIZE=32

# 3. Docker Swarm Automatic Scaling Configuration
AUTO_SCALE_SWARM=true
SWARM_SERVICE_NAME=rag_stack_embedding-service
SWARM_SCALE_THRESHOLD=50
SWARM_SCALE_UP_REPLICAS=3
SWARM_IDLE_REPLICAS=1

# 4. Chroma Local Vector Database
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=rag_documents

# 5. Chunking & Retrieval Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=4

# 6. LLM Synthesis Options: 'groq', 'openai', 'ollama', 'mock'
LLM_PROVIDER=groq

# Groq ChatGroq Configuration
# Get your API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OpenAI configuration:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Optional Ollama configuration:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
